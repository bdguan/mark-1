<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot_320pi">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mycobot_320pi urdf file -->
    <xacro:include filename="$(find mycobot_320pi_description)/urdf/mycobot_320pi.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="mycobot_320pi.ros2_control.xacro" />


    <xacro:mycobot_320pi_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
